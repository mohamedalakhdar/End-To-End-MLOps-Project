# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl
*.joblib

# Ignore virtual environments
venv/
.env/
.venv/
env/
ENV/

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore dataset and large model files (keep them mounted or downloaded at runtime)
data/
datasets/
models/
checkpoints/
*.h5
*.pt
*.pth
*.onnx
*.ckpt

# Ignore logs and temporary files
logs/
*.log
tmp/
temp/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore Git and version control
.git/
.gitignore

# Ignore Docker-related files (except Dockerfile)
docker-compose*.yml
.dockerignore

# Ignore IDE/editor settings
.vscode/
.idea/
*.swp
*.swo

# Ignore build artifacts
build/
dist/
*.egg-info/
